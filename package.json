{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings scripts/gen-pages.mjs && vite",
    "build": "node --experimental-strip-types --no-warnings scripts/gen-pages.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages": "node --experimental-strip-types --no-warnings scripts/gen-pages.mjs",
    "prerender": "node --experimental-strip-types --no-warnings scripts/gen-pages.mjs && tsc -b && PRERENDER_SKIP=1 vite build && python3 scripts/prerender.py dist"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
